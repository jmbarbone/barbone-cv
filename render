#!/usr/bin/env -S Rscript

library(scribe, lib = Sys.getenv("R_LIBS_SCRIBE"))
devtools::load_all()

pandoc::pandoc_activate("3.4")

ca <- command_args()
ca$add_argument(
  "outputs",
  default = c("resume", "cv"),
  info = "Outputs to render"
)

args <- ca$parse()

for (output in args$outputs) {
  switch(
    output,
    resume = quarto::quarto_render(
      "resume.qmd",
      output_file = "Barbone-Resume.pdf"
    ),
    cv = quarto::quarto_render(
      "cv.qmd",
      output_file = "Barbone-CV.pdf"
    ),
    stop("Unknown output: ", output)
  )
}

withr::with_options(
  list(cli.width = 80),
  sessioninfo::session_info(to_file = TRUE)
)
